      "references": [
        "references/power-ground.md"
      ],
      "rules": [
        "PCB-L02/L03/L10"
      ],
      "trigger": "switching regulator/driver hot loop",
      "evidence_required": true
    },
    "rf": {
      "references": [
        "references/pcb-rf.md",
        "references/mcp-tooling.md"
      ],
      "rules": [
        "RF-REVIEW"
      ],
      "trigger": "confirmed RF path or antenna",
      "evidence_required": true
    },
    "fpc": {
      "references": [
        "references/pcb-fpc.md"
      ],
      "rules": [
        "FPC-REVIEW"
      ],
      "trigger": "confirmed flexible material/mechanics",
      "evidence_required": true
