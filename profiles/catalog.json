        "references/schematic-style.md",
        "references/easyeda-schematic.md"
      ],
      "rules": [
        "SCH-01–34"
      ],
      "trigger": "schematic editing/review",
      "evidence_required": true
    },
    "pcb": {
      "references": [
        "references/layout-manufacturing.md",
        "references/pcb-stage-review.md",
        "references/verification.md"
      ],
      "rules": [
        "PCB-V07",
        "PCB-V08",
        "PCB-V09",
        "PCB-P11",
        "PCB-V04"
      ],
      "trigger": "PCB layout/routing/final",
      "evidence_required": true
    },
    "power": {
      "references": [
        "references/power-ground.md"
